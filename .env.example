PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/interview_coach
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Email delivery settings
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<the SMTP login Brevo shows you>
SMTP_PASS=<your SMTP key>
EMAIL_FROM="AI Mock Interview Coach <your-verified-sender@gmail.com>"
FRONTEND_URL=http://localhost:5173
EMAIL_MODE=console

# ------------------------------------------------------------------------------
# Rate Limiting Configuration
# Defaults adjust automatically based on NODE_ENV.
# Stricter per-email limits (5 failed logins per 15 min per email, 5 verification
# or reset emails per hour per email, 60s cooldown) are always strictly enforced.
# ------------------------------------------------------------------------------

# Disable all rate limiting during local development (IGNORED in production)
# RATE_LIMIT_DISABLED=true

# Register endpoint limit per IP
# Production default: 15 per hour per IP (Development default: 100)
RATE_LIMIT_REGISTER_MAX=15
RATE_LIMIT_REGISTER_WINDOW_MS=3600000

# Login endpoint limit per IP
# Production default: 20 per 15 min per IP (Development default: 100)
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Forgot password endpoint limit per IP
# Production default: 15 per 15 min per IP (Development default: 100)
RATE_LIMIT_FORGOT_MAX=15
RATE_LIMIT_FORGOT_WINDOW_MS=900000

# Resend email verification limit per IP
# Production default: 15 per 15 min per IP (Development default: 100)
RATE_LIMIT_RESEND_MAX=15
RATE_LIMIT_RESEND_WINDOW_MS=900000

# Verify email endpoint limit per IP
# Production default: 30 per 15 min per IP (Development default: 100)
RATE_LIMIT_VERIFY_MAX=30
RATE_LIMIT_VERIFY_WINDOW_MS=900000

# Reset password endpoint limit per IP
# Production default: 15 per 15 min per IP (Development default: 100)
RATE_LIMIT_RESET_MAX=15
RATE_LIMIT_RESET_WINDOW_MS=900000
