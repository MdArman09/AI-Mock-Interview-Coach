# Frontend Environment Variables Template
# Copy this file to client/.env for local development

# Base URL of the backend Express API (leave empty if using Vite proxy, or set to http://localhost:5000 in dev)
VITE_API_URL=http://localhost:5000

# Optional: Google OAuth 2.0 Web Client ID for Google Sign-in button
# Leave empty or set to your Google Cloud Console Web Client ID
VITE_GOOGLE_CLIENT_ID=
