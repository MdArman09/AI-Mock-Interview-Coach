# ==============================================================================
# AI Mock Interview Coach — Backend Environment Configuration Template
# All keys must be defined per deployment environment.
# Keep this file checked into version control with EMPTY values or safe dev defaults only.
# Never commit actual production credentials or private keys.
# ==============================================================================

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/interview_coach
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
CORS_STRICT=false
SUPPORT_EMAIL=support@example.com

# Optional: Google OAuth 2.0 Client ID (verifies audience in ID token)
GOOGLE_CLIENT_ID=

# Email delivery settings:
# EMAIL_MODE options: 'console' (local logs, no provider needed), 'brevo' (HTTPS REST API on port 443, recommended for Render), or 'smtp' (traditional SMTP)
EMAIL_MODE=console
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AI Mock Interview Coach <no-reply@example.com>"

# Rate Limiting Configuration (Per-IP limits)
# Set to 'true' only to disable during local development (strictly ignored in production)
RATE_LIMIT_DISABLED=false

# Register endpoint limit per IP
RATE_LIMIT_REGISTER_MAX=15
RATE_LIMIT_REGISTER_WINDOW_MS=3600000

# Login endpoint limit per IP
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Forgot password endpoint limit per IP
RATE_LIMIT_FORGOT_MAX=15
RATE_LIMIT_FORGOT_WINDOW_MS=900000

# Resend email verification limit per IP
RATE_LIMIT_RESEND_MAX=15
RATE_LIMIT_RESEND_WINDOW_MS=900000

# Verify email endpoint limit per IP
RATE_LIMIT_VERIFY_MAX=30
RATE_LIMIT_VERIFY_WINDOW_MS=900000

# Reset password endpoint limit per IP
RATE_LIMIT_RESET_MAX=15
RATE_LIMIT_RESET_WINDOW_MS=900000

# Delete account endpoint limit per IP
RATE_LIMIT_DELETE_ACCOUNT_MAX=5
RATE_LIMIT_DELETE_ACCOUNT_WINDOW_MS=900000

# Contact form endpoint limit per IP
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_MS=900000

# Cost and Groq Quota Abuse Protection (Per-user limits for authenticated endpoints)
RATE_LIMIT_ANALYZE_HOURLY=30
RATE_LIMIT_ANALYZE_DAILY=100
RATE_LIMIT_RESUME_UPLOAD_HOURLY=10
RATE_LIMIT_RESUME_UPLOAD_DAILY=25
RATE_LIMIT_GENERATE_QUESTIONS_HOURLY=5
RATE_LIMIT_GENERATE_QUESTIONS_DAILY=20