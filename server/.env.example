# ==============================================================================
# AI Mock Interview Coach — Environment Configuration Template
# All keys must be defined. Values should be populated per deployment environment.
# Keep this file checked into version control with EMPTY values only.
# ==============================================================================

PORT=
NODE_ENV=
MONGO_URI=
GROQ_API_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=
FRONTEND_URL=
CORS_ORIGINS=

# Email delivery settings:
# Option A (Recommended for Render free tier): RESEND_API_KEY
# Option B (Traditional SMTP): SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
# Option C (Logs only): EMAIL_MODE=console
EMAIL_MODE=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Rate Limiting Configuration (Per-IP limits)
# Set to 'true' only to disable during local development (ignored in production)
RATE_LIMIT_DISABLED=

# Register endpoint limit per IP
RATE_LIMIT_REGISTER_MAX=
RATE_LIMIT_REGISTER_WINDOW_MS=

# Login endpoint limit per IP
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW_MS=

# Forgot password endpoint limit per IP
RATE_LIMIT_FORGOT_MAX=
RATE_LIMIT_FORGOT_WINDOW_MS=

# Resend email verification limit per IP
RATE_LIMIT_RESEND_MAX=
RATE_LIMIT_RESEND_WINDOW_MS=

# Verify email endpoint limit per IP
RATE_LIMIT_VERIFY_MAX=
RATE_LIMIT_VERIFY_WINDOW_MS=

# Reset password endpoint limit per IP
RATE_LIMIT_RESET_MAX=
RATE_LIMIT_RESET_WINDOW_MS=

# Cost and Groq Quota Abuse Protection (Per-user limits)
RATE_LIMIT_ANALYZE_HOURLY=
RATE_LIMIT_ANALYZE_DAILY=
RATE_LIMIT_RESUME_UPLOAD_HOURLY=
RATE_LIMIT_RESUME_UPLOAD_DAILY=
RATE_LIMIT_GENERATE_QUESTIONS_HOURLY=
RATE_LIMIT_GENERATE_QUESTIONS_DAILY=